# npm run setup generates random local credentials; do not use placeholders.
POSTGRES_DB=equiprent_model
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-random-password
API_DB_PASSWORD=replace-with-another-random-password
API_ADMIN_KEY=replace-with-at-least-32-random-characters
API_READ_KEY=replace-with-a-different-32-character-key
API_PORT=3100
PG_PORT=55440
PGHOST=127.0.0.1
PGPORT=55440
PGDATABASE=equiprent_model
PGUSER=equiprent_api
PGPASSWORD=replace-with-API_DB_PASSWORD
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
DB_POOL_MAX=10
